# Copy to .env (gitignored) next to compose.yaml and fill in before running
# docker compose -f deploy/stacks/community/compose.yaml up -d

# Required: the relay's private key (hex or nsec). It signs group state and
# membership lists. Generate one with: ncli id --json
RELAY_PRIVKEY=

# Required: the relay's public address, e.g. wss://community.example.com.
# NIP-42 logins and NIP-98 requests are checked against it.
RELAY_URL=

# Required: Meilisearch master key. Generate with: openssl rand -base64 32
MEILI_MASTER_KEY=

# Required: MinIO root credentials (the password needs 8+ characters).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Optional: the media bucket (default ncli-media), image tag (default
# 0.8.0-rc.50) and host address to publish on (default 0.0.0.0).
# MINIO_BUCKET=ncli-media
# NCLI_VERSION=0.8.0-rc.50
# RELAY_BIND=127.0.0.1

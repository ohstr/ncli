# Copy to .env (gitignored) next to compose.yaml and fill in before running
# docker compose -f deploy/stacks/public-search/compose.yaml up -d

# Required: the relay's private key (hex or nsec). It signs zap rankings,
# NIP-85 stats and NIP-66 stats. Generate one with: ncli id --json
RELAY_PRIVKEY=

# Required: the relay's public address, e.g. wss://relay.example.com
RELAY_URL=

# Required: Meilisearch master key, shared by the relay and Meilisearch.
# Generate one with: openssl rand -base64 32
MEILI_MASTER_KEY=

# Optional: image tag (default 0.8.0-rc.51) and host address to publish on
# (default 0.0.0.0; 127.0.0.1 behind a local reverse proxy).
# NCLI_VERSION=0.8.0-rc.51
# RELAY_BIND=127.0.0.1

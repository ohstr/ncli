      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(ncli_relay_events_total{result=\"rejected\"}[$__rate_interval])) / clamp_min(sum(rate(ncli_relay_events_total{result=~\"accepted|duplicate|rejected\"}[$__rate_interval])), 0.01)",
          "refId": "A"
        }
      ]
    },
